#include <iostream>
#include <string>
#include <vector>
#include <cmath>
int collatz(int n) { // using an integer n as input to return the sequence of numbers gathered by the collatz conjecture to get to 1.
    if (n == 1) {
        return 0;
    } else if (n % 2 == 0) { //If n is even, divide by 2
        return 1 + collatz(n / 2);
    } else { //If n is odd, multiply by 3 and add 1
        return 1 + collatz(3 * n + 1);
    }
}
    int sequence(int n) {
        std::vector<int> seq;
        while (n != 1) {
            seq.push_back(n);
            if (n % 2 == 0) {
                n /= 2;
            } else {
                n = 3 * n + 1;
            }
        }
        seq.push_back(1); // Add the final 1 to the sequence
        for (int i = 0; i < seq.size(); ++i) {
            std::cout << seq[i];
            if (i < seq.size() - 1) {
                std::cout << " -> ";
            }
        }
        return 0;
}

int main() {
    int InputN;
    std::cout << "Enter a positive integer: "; //Prompt user for input (N)
    std::cin >> InputN;
    std::cout << "The number of steps required to reach 1 is: " << collatz(InputN) << std::endl; //Output the number of steps required to reach 1
    std::cout << "The sequence of numbers generated by the Collatz conjecture is: ";
    sequence(InputN);
    std::cout << std::endl;
    
    std::cout << "Do you want to run the program again? (y/n): "; //ask the user if they want to run the program again
    char choice;
